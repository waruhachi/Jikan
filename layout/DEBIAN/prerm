#!/bin/sh
set -e

case "$1" in
	remove|upgrade|deconfigure)
		domain=system
		kernel_release=$(uname -r 2>/dev/null || true)
		kernel_major=${kernel_release%%.*}
		case "$kernel_major" in
			''|*[!0-9]*) ;;
			*)
				if [ "$kernel_major" -ge 22 ] && launchctl print user/foreground >/dev/null 2>&1; then
					domain=user/foreground
				fi
				;;
		esac

		launchctl bootout "$domain/moe.waru.jikan.input-power" >/dev/null 2>&1 || true
		;;
esac
